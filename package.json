{
  "name": "veilo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "dev": "tsx scripts/dev.ts",
    "check": "pnpm run typecheck && pnpm run lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "vectors:generate": "tsx packages/privacy-sdk/scripts/vectors.ts generate",
    "vectors:check": "tsx packages/privacy-sdk/scripts/vectors.ts check && pnpm tc -- sh -c \"python3 -I packages/privacy-sdk/scripts/check_vectors.py artifacts/vectors/v1.json && cargo test -p veilo-crypto --test vectors\" && tsx circuits/scripts/build.ts && pnpm --filter @veilo/circuits exec vitest run test/vectors.test.ts",
    "test:circuits": "tsx circuits/scripts/build.ts && tsx circuits/scripts/groth16-vectors.ts && pnpm --filter @veilo/circuits exec vitest run && pnpm tc -- cargo test -p veilo-crypto",
    "test:program": "tsx scripts/program-fixtures.ts && tsx scripts/sdk-builder-fixtures.ts && pnpm tc -- sh programs/privacy-pool/scripts/test.sh",
    "test:integration": "tsx scripts/test-integration.ts",
    "keys:init": "tsx scripts/devnet/keys-init.ts",
    "program:set-id": "tsx scripts/devnet/set-program-id.ts",
    "deploy:devnet": "tsx scripts/devnet/deploy.ts",
    "demo:private-smoke": "tsx scripts/devnet/private-smoke.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:run": "tsx scripts/demo-run.ts",
    "evidence:export": "tsx scripts/evidence-export.ts",
    "backup": "tsx services/wallet/src/cli/backup.ts backup",
    "restore": "tsx services/wallet/src/cli/backup.ts restore",
    "check:devnet": "tsx scripts/check-devnet.ts",
    "toolchain:build": "node scripts/toolchain.mjs --build",
    "tc": "node scripts/toolchain.mjs",
    "test:marketplace-rls": "tsx scripts/marketplace/rls-e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solana/kit": "5.5.1",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "22.20.5",
    "@veilo/contracts": "workspace:*",
    "@veilo/x402-client": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/svm": "2.28.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
