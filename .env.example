# Veilo local configuration template. Copy to .env and fill locally. Never commit .env.

# Solana devnet only; mainnet genesis/CAIP-2 are rejected at startup.
DEVNET_RPC_URL=https://api.devnet.solana.com
EXPECTED_DEVNET_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
DEMO_TOKEN_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
FACILITATOR_URL=https://facilitator.payai.network

# Filled after pnpm deploy:devnet.
POOL_PROGRAM_ID=
POOL_ID=
DEPLOYMENT_MANIFEST_PATH=artifacts/deployment/devnet.json

# Operator-funded inference. Use a key with its own spend limit.
OPENROUTER_API_KEY=
# Owners bring their own model key in Settings (stored encrypted by control). Set to 1 only on a
# development machine to let an owner point agents at a model server on localhost.
AI_ALLOW_LOCAL_PROVIDER=
# Pinned allowlisted model (tariff pinned in services/gateway/src/provider/pinned-models.ts).
PLANNER_MODEL_ID=deepseek/deepseek-v4-flash
INFERENCE_MODEL_ID=deepseek/deepseek-v4-flash
# Real-dollar ceiling in micro-USD. 0 disables real inference.
OPERATOR_MAX_REAL_USD_MICRO=0

# Secret file paths (contents are never printed).
SPONSOR_KEY_PATH=
OWNER_SERVICE_SECRET_PATH=

# Databases.
CONTROL_DATABASE_PATH=data/control.sqlite
GATEWAY_DATABASE_PATH=data/gateway.sqlite

# Optional; defaults to the devnet CAIP-2 id. Any other value is rejected.
SOLANA_CAIP2_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Local directories created by pnpm setup:local with owner-only permissions.
VEILO_DATA_DIR=data
VEILO_SECRETS_DIR=secrets

# Service listeners. Keep the bind host on loopback for the local deployment.
VEILO_BIND_HOST=127.0.0.1
DASHBOARD_PORT=3000
CONTROL_PORT=4101
RUNNER_PORT=4102
WALLET_PORT=4103
GATEWAY_PORT=4104
RELAYER_PORT=4105

# Per-service credential files (contents are never printed; setup does not create them).
CONTROL_SERVICE_CREDENTIAL_PATH=
RUNNER_WORKER_CREDENTIAL_PATH=
# 1 = control issues runner credentials for newly activated agents (single-host local only).
CONTROL_PROVISION_RUNNER_CREDENTIALS=
WALLET_SERVICE_CREDENTIAL_PATH=
GATEWAY_ADMIN_CREDENTIAL_PATH=
RELAYER_SERVICE_CREDENTIAL_PATH=

# Funded devnet bootstrap wallet (local file only).
FUNDING_KEY_PATH=

# Gateway (x402 merchant, credits, inference). Recipient values may instead come from the
# deployment manifest "gateway" section; a disagreement fails closed.
GATEWAY_IDENTITY=veilo-gateway-devnet
GATEWAY_PUBLIC_ORIGIN=
GATEWAY_MERCHANT_ADDRESS=
GATEWAY_MERCHANT_ATA=
# PayAI devnet fee payer; startup verifies it is advertised by FACILITATOR_URL/supported.
GATEWAY_FACILITATOR_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4
GATEWAY_QUOTE_TTL_SECONDS=600
GATEWAY_PROVIDER_TIMEOUT_MS=60000
GATEWAY_PRICING_MAX_AGE_SECONDS=21600
GATEWAY_SETTLEMENT_WAIT_MS=40000
# Ed25519 public key (PEM) of the control service usage-permit signer (created by pnpm demo:seed).
USAGE_PERMIT_PUBLIC_KEY_PATH=secrets/gateway/usage-permit-public.pem
# Bearer credential control presents for operator-sponsored planning (created by pnpm demo:seed).
GATEWAY_PLANNING_CREDENTIAL_PATH=secrets/gateway/planning.token

# Control integration (created by pnpm demo:seed; control only, never the runner).
VEILO_OWNER_PUBKEY=
# Guest wallets (comma-separated base58): read everything and run agents; never fund, configure or decide.
VEILO_GUEST_PUBKEYS=
# Agent runs each guest wallet may start per rolling hour (default 20).
VEILO_GUEST_RUNS_PER_HOUR=
# 1 serves an anonymous, redacted read-only view when no session is present. Default off.
VEILO_PUBLIC_VIEW=0
CONTROL_USAGE_PERMIT_KEY_PATH=secrets/control/usage-permit-signing.pem
CONTROL_GATEWAY_ACCOUNT_TOKEN_PATH=secrets/control/gateway-account.token

# Runner tool HTTP: comma-separated exact origins; local origins may resolve to loopback.
RUNNER_APPROVED_FETCH_ORIGINS=
RUNNER_LOCAL_SERVICE_ORIGINS=

# Wallet/relayer. OWNER_RECOVERY_ADDRESS is the only owner recovery destination.
OWNER_RECOVERY_ADDRESS=
RELAYER_SPONSOR_LAMPORT_CAP=100000000
APPROVED_LABELS_PATH=artifacts/deployment/approved-labels.json
APPROVED_PARTICIPANTS=

# ---- Marketplace (optional; PRD §26) -------------------------------------------------------
# Supabase project used for marketplace identity and product records only. The secret key
# reaches only the marketplace process; never expose it to the dashboard or agents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Marketplace API (services/marketplace).
MARKETPLACE_PORT=4106
MARKETPLACE_BROWSER_ORIGINS=http://localhost:3000
# Must stay under the database cap of 15 minutes; long enough for the private funding path.
MARKETPLACE_QUOTE_TTL_SECONDS=840
# Bearer credentials shared with the seller host and the operator CLI; created by pnpm setup:local.
MARKETPLACE_SELLER_HOST_TOKEN_PATH=secrets/marketplace/seller-host.token
MARKETPLACE_OPERATOR_TOKEN_PATH=secrets/marketplace/operator.token
# Managed specialist jobs run on this seller host (gateway with GATEWAY_ROLE=seller-host).
MARKETPLACE_MANAGED_SELLER_ORIGIN=http://127.0.0.1:4107
MARKETPLACE_MANAGED_SELLER_IDENTITY=veilo-seller-host-devnet
# Exact loopback/private origins allowed for local remote-seller tests only.
MARKETPLACE_DEV_SELLER_ORIGINS=
# Seller host (services/gateway, GATEWAY_ROLE=seller-host; set the role per process, not here).
SELLER_HOST_PORT=4107
SELLER_HOST_PUBLIC_ORIGIN=http://127.0.0.1:4107
SELLER_HOST_DATABASE_PATH=data/seller-host.sqlite
# Control and seller host reach the marketplace here; control signs every request.
MARKETPLACE_URL=http://127.0.0.1:4106
# The local seller host is loopback, so control must allow exactly its origin.
MARKETPLACE_LOCAL_SELLER_ORIGINS=http://127.0.0.1:4107
MARKETPLACE_MAX_PAYMENT_UNITS=1000000
# Dashboard (baked in at build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MARKETPLACE_URL=http://127.0.0.1:4106

# Hosted dashboard only (e.g. Vercel): HTTPS URLs of the services. Leave empty locally.
VEILO_CONTROL_URL=
VEILO_WALLET_URL=
VEILO_RELAYER_URL=
