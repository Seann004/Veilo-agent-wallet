# Veilo local configuration template. Copy to .env and fill locally. Never commit .env.

# Solana devnet only; mainnet genesis/CAIP-2 are rejected at startup.
DEVNET_RPC_URL=https://api.devnet.solana.com
EXPECTED_DEVNET_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
DEMO_TOKEN_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
FACILITATOR_URL=https://facilitator.payai.network

# Filled after pnpm deploy:devnet.
POOL_PROGRAM_ID=
POOL_ID=
DEPLOYMENT_MANIFEST_PATH=artifacts/deployment/devnet.json

# Operator-funded inference. Use a key with its own spend limit.
OPENROUTER_API_KEY=
PLANNER_MODEL_ID=
INFERENCE_MODEL_ID=
# Real-dollar ceiling in micro-USD. 0 disables real inference.
OPERATOR_MAX_REAL_USD_MICRO=0

# Secret file paths (contents are never printed).
SPONSOR_KEY_PATH=
OWNER_SERVICE_SECRET_PATH=

# Databases.
CONTROL_DATABASE_PATH=data/control.sqlite
GATEWAY_DATABASE_PATH=data/gateway.sqlite

# Optional; defaults to the devnet CAIP-2 id. Any other value is rejected.
SOLANA_CAIP2_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Local directories created by pnpm setup:local with owner-only permissions.
VEILO_DATA_DIR=data
VEILO_SECRETS_DIR=secrets

# Service listeners. Keep the bind host on loopback for the local deployment.
VEILO_BIND_HOST=127.0.0.1
DASHBOARD_PORT=3000
CONTROL_PORT=4101
RUNNER_PORT=4102
WALLET_PORT=4103
GATEWAY_PORT=4104
RELAYER_PORT=4105

# Per-service credential files (contents are never printed; setup does not create them).
CONTROL_SERVICE_CREDENTIAL_PATH=
RUNNER_WORKER_CREDENTIAL_PATH=
WALLET_SERVICE_CREDENTIAL_PATH=
GATEWAY_ADMIN_CREDENTIAL_PATH=
RELAYER_SERVICE_CREDENTIAL_PATH=
